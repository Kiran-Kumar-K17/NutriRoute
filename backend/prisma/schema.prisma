generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String      @id @default(uuid())
  name           String
  email          String      @unique
  password       String
  phone          String      @unique @db.VarChar(10)
  role           UserRole    @default(CUSTOMER)
  street         String
  village        String
  city           String
  pincode        String      @db.VarChar(6)
  latitude       Float?
  longitude      Float?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  customerOrders Order[]     @relation("CustomerOrders")
  deliveryOrders Order[]     @relation("DeliveryOrders")
  restaurants    Restaurant?
}

model Restaurant {
  id            String   @id @default(uuid())
  name          String
  description   String
  image         String
  imagePublicId String
  phone         String   @unique @db.VarChar(10)
  email         String   @unique
  street        String
  area          String
  city          String
  state         String
  pincode       String   @db.VarChar(6)
  cuisine       String[]
  openingTime   String
  closingTime   String
  rating        Float    @default(0)
  totalReviews  Int      @default(0)
  isOpen        Boolean  @default(true)
  ownerId       String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  foods         Food[]
  orders        Order[]
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
}

model Order {
  id                String        @id @default(uuid())
  customerId        String
  restaurantId      String
  deliveryPartnerId String?
  totalAmount       Decimal       @db.Decimal(10, 2)
  street            String
  village           String
  city              String
  pincode           String
  paymentMethod     PaymentMethod @default(COD)
  paymentStatus     PaymentStatus @default(PENDING)
  orderStatus       OrderStatus   @default(PENDING)
  paymentId         String?
  razorpayOrderId   String?
  transactionId     String?
  latitude          Float?
  longitude         Float?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  customer          User          @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  deliveryPartner   User?         @relation("DeliveryOrders", fields: [deliveryPartnerId], references: [id])
  restaurant        Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  items             OrderItem[]
}

model OrderItem {
  id        String   @id @default(uuid())
  orderId   String
  foodId    String
  quantity  Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  food      Food     @relation(fields: [foodId], references: [id], onDelete: Cascade)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Food {
  id            String      @id @default(uuid())
  name          String      @db.VarChar(100)
  description   String
  price         Decimal     @db.Decimal(10, 2)
  image         String
  imagePublicId String
  category      String      @db.VarChar(50)
  stock         Int         @default(100)
  isAvailable   Boolean     @default(true)
  restaurantId  String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  restaurant    Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([restaurantId])
}

enum UserRole {
  CUSTOMER
  RESTAURANT
  DELIVERY
}

enum PaymentMethod {
  COD
  UPI
  CARD
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  PREPARING
  READY_FOR_PICKUP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}
